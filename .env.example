OPENAI_API_KEY=tu-clave
# OPENAI_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# Generación de imagen alternativa con Gemini (--image-provider gemini)
# Se genera gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-clave-de-gemini
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Publicación en Instagram (Instagram API with Instagram Login - Content Publishing)
# El token se genera logueándote con la cuenta de Instagram desde el producto
# "Instagram API setup with Instagram business login" en el dashboard de la app.
# Empieza con "IGAA..." y solo es válido contra graph.instagram.com (no graph.facebook.com).
IG_ACCESS_TOKEN=tu-instagram-access-token-igaa
IG_BUSINESS_ACCOUNT_ID=tu-instagram-business-account-id
# GRAPH_API_VERSION=v21.0

# Cloudflare R2: hosting público temporal de la imagen antes de publicarla
# (la Graph API de Meta exige una URL pública, no acepta upload de archivo).
# Bucket con "Public Development URL" habilitada en el dashboard de R2.
R2_ACCOUNT_ID=tu-cloudflare-account-id
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=tu-bucket-r2
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
